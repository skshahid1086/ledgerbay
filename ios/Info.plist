<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Ledgerbay</string>
	<key>CFBundleName</key>
	<string>Ledgerbay</string>
	<key>CFBundleShortVersionString</key>
	<string>1.13.22</string>
	<key>CFBundleVersion</key>
	<string>175</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Ledgerbay uses the camera to scan item barcodes.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Ledgerbay can reach a Ledgerbay sync server on your local network. Books stay on this device when sync is off.</string>
